{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "WebWorker"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  "//": "Test-only files (tests + test-utils) are typechecked separately by tsconfig.test.json, which adds Node types for the D1 migration harness. Excluding them here keeps the shipped-code gate on WebWorker globals only.",
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test-utils/**"]
}
